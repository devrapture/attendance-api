# Copy this file to `.env` to use the local Compose database.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL="postgresql://attendance:attendance_dev_password@localhost:5433/attendance"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters # openssl rand -hex 32
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret # openssl rand -hex 32
JWT_ISSUER=attendance-api
JWT_AUDIENCE=attendance-clients
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_SECONDS=1800
CORS_ORIGINS=http://localhost:3001
